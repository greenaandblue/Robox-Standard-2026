        "${workspaceFolder}/firmware/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/firmware/Middlewares/Third_Party/FreeRTOS/Source/include",
        "${workspaceFolder}/firmware/Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS",
        "${workspaceFolder}/firmware/Middlewares/Third_Party/FreeRTOS/Source/portable/RVDS/ARM_CM4F",
        "${workspaceFolder}/firmware/Drivers/CMSIS/Device/ST/STM32F4xx/Include",
        "${workspaceFolder}/firmware/Drivers/CMSIS/Include",
        "${workspaceFolder}/firmware/application",
        "${workspaceFolder}/firmware/bsp/boards",
        "${workspaceFolder}/firmware/components/devices",
        "${workspaceFolder}/firmware/components/algorithm",
        "${workspaceFolder}/firmware/components/algorithm/Include",
        "${workspaceFolder}/firmware/components/support",
        "${workspaceFolder}/firmware/application/protocol",
        "${workspaceFolder}/firmware/components/controller",
